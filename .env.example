# Server
PORT=3000

# PostgreSQL (local)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_ticket_workspace

# Prisma datasource URL (for Docker, use postgres://postgres:postgres@postgres:5432/ai_ticket_workspace)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_ticket_workspace?schema=public"

# AI_API_KEY: API key for the AI provider (OpenRouter, Groq, etc.)
AI_API_KEY=your_api_key_here

# AI_BASE_URL: Base URL for the AI API (OpenAI SDK compatible). Default: https://api.groq.com/openai/v1
AI_BASE_URL=https://api.groq.com/openai/v1

# AI_MODEL: Model name for ticket classification. Default: openai/gpt-oss-20b
AI_MODEL=openai/gpt-oss-20b

# Frontend (only used when running frontend separately)
PUBLIC_API_URL=http://localhost:3000
